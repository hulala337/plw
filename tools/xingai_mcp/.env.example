# Reference only: server.py does NOT automatically load .env files.
# Set OPENAI_API_KEY securely in the parent process; never commit its value.
OPENAI_API_KEY=
XINGAI_BASE_URL=https://xingai.ai
# Relative roots are relative to C:/Projects/plw; output_path is relative to this root.
XINGAI_OUTPUT_ROOT=tools/xingai_mcp/outputs
# Optional evidence-backed model config, confined to the project.
# XINGAI_MODEL_CONFIG=tools/xingai_mcp/models.local.json
# Comma-separated exact trusted CDN hosts; no wildcards, no schemes.
XINGAI_DOWNLOAD_HOSTS=
# Leave unconfirmed until XingAI confirms the linked New API contract is deployed.
XINGAI_VIDEO_ADAPTER=unconfirmed
